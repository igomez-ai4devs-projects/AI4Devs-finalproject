# Sport ITSM API — environment template.
#
# Copy to `.env` at the repository root and adjust. `PERSISTENCE_MODE` is
# always MANDATORY and has no in-code default. The five POSTGRES_* keys below
# are MANDATORY only when PERSISTENCE_MODE=postgres — optional, and ignored,
# when PERSISTENCE_MODE=memory. The API validates this environment at boot
# (`apps/api/src/config/env.validation.ts`) and refuses to start when a
# mandatory key is missing or malformed, naming the offending key.
#
# Keys are added here as the capabilities that need them land — the database
# connection with T-C10-16, observability with T-C10-28, the persistence
# switch with T-C10-75 (ADR-015).

# Deployment environment: development | test | staging | production
NODE_ENV=development

# TCP port the HTTP server binds to (1-65535).
PORT=3300

# Persistence backend: postgres | memory (T-C10-75, ADR-015). Mandatory, no
# default — choosing the non-durable `memory` store must be an explicit act.
PERSISTENCE_MODE=postgres

# --- Database (T-C10-16) -----------------------------------------------------
# Mandatory only when PERSISTENCE_MODE=postgres above. These names mirror the
# POSTGRES_* variables the `postgres` service declares in
# docker/docker-compose.dev.yml, so the same names are set on both sides of the
# connection. The values below match that service as it ships for development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5452
POSTGRES_DB=sport_itsm_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
