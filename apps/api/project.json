{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["platform:backend", "scope:shared", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "build-migrations": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/tsconfig.migrations.json",
        "{projectRoot}/tsconfig.app.json",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/src/data-source.ts",
        "{projectRoot}/src/config/environment.ts",
        "{projectRoot}/src/config/env.validation.ts",
        "{projectRoot}/src/migrations/**/*.ts",
        "{workspaceRoot}/tools/build-api-runtime.mjs",
        "{workspaceRoot}/package.json"
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/api/data-source.js",
        "{workspaceRoot}/dist/apps/api/config",
        "{workspaceRoot}/dist/apps/api/migrations",
        "{workspaceRoot}/dist/apps/api/package.json"
      ],
      "options": {
        "command": "node tools/build-api-runtime.mjs"
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
