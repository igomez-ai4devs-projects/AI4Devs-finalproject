{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "importHelpers": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    // Required by TypeORM's own column/entity decorators (`incident.entity.ts`)
    // and by Nest's constructor-parameter injection of the concrete
    // `DataSource` class (`typeorm-incident.repository.ts`, T-C1-06 Trap 4) —
    // matches `apps/api/tsconfig.app.json`, which already sets both for the
    // same reason.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./tsconfig.integration.json"
    }
  ]
}
